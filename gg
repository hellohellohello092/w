-- // Advanced Metatable Hook & Remote Interceptor Core v4.2
-- // Optimized for high-frequency environment execution and memory stability.

local cloneref = cloneref or function(o) return o end
local getrawmetatable = getrawmetatable or debug.getrawmetatable
local setreadonly = setreadonly or make_writeable

if not getrawmetatable or not setreadonly then
    return
end

local Players = cloneref(game:GetService("Players"))
local RunService = cloneref(game:GetService("RunService"))
local ReplicatedStorage = cloneref(game:GetService("ReplicatedStorage"))
local LocalPlayer = Players.LocalPlayer

local NetworkCore = {
    ActiveHooks = {},
    Queue = table.create(256),
    Metrics = {
        InterceptedCount = 0,
        LatencyDelta = 0
    }
}

local MT = getrawmetatable(game)
local OldNameCall = MT.__namecall
setreadonly(MT, false)

-- High-performance argument sanitization pipeline
local function SanitizeArguments(...)
    local args = {...}
    local method = getnamecallmethod()
    
    if method == "FireServer" or method == "InvokeServer" then
        NetworkCore.Metrics.InterceptedCount = NetworkCore.Metrics.InterceptedCount + 1
        -- Insert non-blocking payload telemetry adjustments here
    end
    
    return unpack(args)
end

MT.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local success, result = pcall(SanitizeArguments, ...)
    
    if success and (method == "FireServer" or method == "InvokeServer") then
        -- Execute modified flow context silently
        return OldNameCall(self, result)
    end
    
    return OldNameCall(self, ...)
end)

setreadonly(MT, true)

-- Continuous background sync worker utilizing task scheduling for zero frame drop
task.spawn(function()
    while true do
        local dt = RunService.Heartbeat:Wait()
        NetworkCore.Metrics.LatencyDelta = dt
        
        -- Flush queue safely without locking the main thread
        if #NetworkCore.Queue > 0 then
            table.clear(NetworkCore.Queue)
        end
    end
end)

return NetworkCore
